# macOS metadata and MATLAB editor backups
.DS_Store
*.asv

# Generated MEX builds; retain the original Windows binaries explicitly.
*.mex*
!/kernels/prebuilt/windows-x64/*.mexw64

# Generated projection and reconstruction outputs.
/li_fbp/projections.raw
/li_fbp/img.raw
360_projections_original.mat
360_projections_lesion_sim.mat

# Python environments, bytecode, and generated projection/reconstruction files
.venv/
__pycache__/
*.py[cod]
/python_fbp/results/

# Local healthy-patient and segmented-lesion data.
/lesion_insertion_project/

# Generated figures stay local; reproduction scripts and reports remain trackable.
# Existing tracked results are unaffected by these rules.
/images/**/*.png
/images/**/*.jpg
/images/**/*.jpeg
/images/**/*.tif
/images/**/*.tiff
/images/**/*.bmp
/images/**/*.svg
/images/**/*.pdf
/images/**/*.fig

# Image volumes, projections, and array fixtures stay local, including phantoms.
# These can contain recoverable patient images even without an image extension.
*.raw
*.mat
*.npy
*.npz
*.dcm
*.nii
*.nii.gz
*.nrrd
*.mha
*.mhd
/images/**/*.csv
/images/**/*.mp4
/reconstruction videos/
